# Copiar este archivo como .env y completar. El archivo .env NUNCA se comparte ni se sube a git.

# --- Telegram ---
# Bot propio para este agente: @BotFather → /newbot → copiar el token.
TELEGRAM_BOT_TOKEN=
# Los únicos chats que pueden dar órdenes (separados por coma). Para saber el tuyo: escríbele algo al bot y
# corre `.venv/bin/python -m mac.bot --quien`. Si está vacío, el bot no obedece a nadie.
TELEGRAM_CHAT_ID=

# --- Chrome ---
# Apodos para tus perfiles: apodo:carpeta, separados por coma. La carpeta sale de `python -m mac.chrome`.
# Ej: CHROME_PERFILES=personal:Default,estudio:Profile 2
CHROME_PERFILES=
# Perfiles que el bot puede usar (carpetas, separadas por coma). Vacío = todos los que estén abiertos.
# Útil para dejar fuera un perfil del trabajo o con datos sensibles.
CHROME_PERFILES_PERMITIDOS=
